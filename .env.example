# Copy to .env (git-ignored). Used ONLY by scripts/seed — the app itself never reads keys.
ALPHAVANTAGE_API_KEY=your_key_here
# Free keys are ~25 requests/day; premium 75+/min. The seeder paces itself and resumes from cache.
AV_REQUESTS_PER_MINUTE=5
AV_DAILY_BUDGET=25
# SEC EDGAR requires a descriptive User-Agent with contact info for N-PORT (mutual fund holdings).
SEC_USER_AGENT=Compass research you@example.com
# Optional overrides
# COMPASS_DB=db/compass.sqlite
# COMPASS_TOP_FUNDS=200
# COMPASS_MAX_HOLDINGS=250
